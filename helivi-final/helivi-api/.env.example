# Copie para .env.local (nunca commitar secrets)

PORT=8787
NODE_ENV=development

# URL pública do projeto Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Chave anon (só para validar JWT no request — nunca service role no browser)
SUPABASE_ANON_KEY=eyJ...

# Service role — SOMENTE neste servidor
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Webhook PIX (obrigatório em NODE_ENV=production)
PIX_WEBHOOK_SECRET=troque-este-segredo

# Efi (opcional — também pode vir de segredos_pagamento no Postgres)
EFI_AMBIENTE=homolog
# EFI_CERT_DIR=../helivi-functions/functions

# Origens CORS do PDV
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://helivi.web.app
