# Copie este arquivo para .env.local e preencha com credenciais do painel Efi
# https://sejaefi.com.br → API → Minhas Aplicações → PDV HELIVI
#
# ═══════════════════════════════════════════════════════════════
# TROCA DE AMBIENTE — altere só esta linha (ou use: npm run efi:homolog / efi:producao)
# ═══════════════════════════════════════════════════════════════
EFI_AMBIENTE=homolog

# Recomendado: credenciais separadas por ambiente (troca automática ao mudar EFI_AMBIENTE)
# Homologação — aba "Homologação" no painel Efi
EFI_HOMOLOG_CLIENT_ID=
EFI_HOMOLOG_CLIENT_SECRET=
EFI_HOMOLOG_PIX_KEY=

# Produção — aba "Produção" no painel Efi
EFI_PROD_CLIENT_ID=
EFI_PROD_CLIENT_SECRET=
EFI_PROD_PIX_KEY=

# Opcional: secret na URL do webhook PIX (?secret=...)
# PIX_WEBHOOK_SECRET=

# Alternativa simples (uma credencial por vez — precisa trocar manualmente ao mudar ambiente):
# EFI_CLIENT_ID=
# EFI_CLIENT_SECRET=
# EFI_PIX_KEY=
